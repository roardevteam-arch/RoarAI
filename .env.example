# ROAR AI Environment Configuration
# Copy this to .env and configure as needed

# Server configuration
PORT=3000
NODE_ENV=production

# Ollama configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=30000

# CORS configuration
CORS_ORIGIN=*

# Request limits
REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=1mb
MAX_TOKENS=2048

# Model fallbacks
DEFAULT_MODEL=roar-pro
FALLBACK_MODELS=roar-pro,llama3,codellama,mistral,llama2

# Logging
LOG_LEVEL=info
